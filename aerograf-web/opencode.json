{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "write": "allow",
    "bash": "allow"
  },
  "mcp": {
    "time": {
      "type": "local",
      "command": ["/usr/bin/python3", "-m", "mcp_server_time", "--local-timezone", "Europe/Madrid"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["/usr/bin/python3", "-m", "mcp_server_fetch"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["/usr/bin/python3", "-m", "mcp_server_git", "--repository", "."],
      "enabled": true
    }
  }
}